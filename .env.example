# --- Supabase (Settings > API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Cloud OAuth (see README Section: Google Cloud setup) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in the Google Cloud OAuth client,
# e.g. https://your-app.vercel.app/api/google/callback (or http://localhost:3000/api/google/callback for local dev)
GOOGLE_REDIRECT_URI=

# --- App security ---
# 32-byte hex string used to encrypt refresh tokens / app-specific passwords at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Random string used to sign the passcode session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Shared secret Vercel Cron must present to trigger /api/cron/sync. Set the same
# value here and as a Vercel project environment variable named CRON_SECRET.
CRON_SECRET=

# --- Misc ---
# Base URL of the deployed app (no trailing slash), used to build links.
APP_URL=http://localhost:3000
